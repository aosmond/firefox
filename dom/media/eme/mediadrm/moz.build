LOCAL_INCLUDES += [
    "!/ipc/ipdl/_ipdlheaders",
    "/ipc/chromium/src",
]

EXPORTS.mozilla += [
    "MediaDrmCDMCallbackProxy.h",
    "MediaDrmCDMProxy.h",
    "MediaDrmProxySupport.h",
    "MediaDrmRemoteCDMParent.h",
]

UNIFIED_SOURCES += [
    "MediaDrmCDMCallbackProxy.cpp",
    "MediaDrmCDMProxy.cpp",
    "MediaDrmProxySupport.cpp",
    "MediaDrmRemoteCDMParent.cpp",
]

FINAL_LIBRARY = "xul"
